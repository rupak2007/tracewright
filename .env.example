# Copy to .env (gitignored) and adjust. Never commit real secrets (SEC-09).
# Values below are local-development placeholders only.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# PostgreSQL (used by the db container and by api/worker)
POSTGRES_DB=tracewright
POSTGRES_USER=tracewright
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional overrides (defaults match the container layout)
# UPLOADS_DIR=/data/uploads
# ARTIFACTS_DIR=/data/artifacts
# ZEEK_BIN=zeek

# Optional LLM narrative (gate G2 not run: default none). Only the API process reads these.
# LLM_PROVIDER=none            # none | ollama | openai_compatible | anthropic
# LLM_MODEL=
# LLM_BASE_URL=                # ollama: http://ollama:11434 ; openai_compatible: https://host/v1
# LLM_API_KEY=                 # external providers only; never commit a real key
# LLM_TIMEOUT_S=120
# API_TOKEN=                   # optional bearer token for every API route except /health
# CORS_ORIGINS=["http://127.0.0.1:8080"]
