# Copy to .env (gitignored) and adjust. Never commit real secrets (SEC-09).
# Values below are local-development placeholders only.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# PostgreSQL (used by the db container and by api/worker)
POSTGRES_DB=tracewright
POSTGRES_USER=tracewright
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional overrides (defaults match the container layout)
# UPLOADS_DIR=/data/uploads
# ARTIFACTS_DIR=/data/artifacts
# ZEEK_BIN=zeek
