# API image: never runs Zeek/tcpdump on capture bytes (SEC-02). Same Python minor as the worker (3.13).
FROM python:3.13-slim-trixie@sha256:bb2988715db2cf7ace7b53f38f3cffbef7c7046a656bee66245eb0ed386e2e81

ARG UV_VERSION=0.12.23
ARG UID=10001

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=/usr/local/bin/python3 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH="/opt/venv/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

RUN groupadd --gid ${UID} tracewright \
 && useradd --uid ${UID} --gid ${UID} --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin tracewright \
 && mkdir -p /data/uploads /data/artifacts \
 && chown ${UID}:${UID} /data/uploads /data/artifacts

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv==${UV_VERSION} \
 && uv sync --frozen --no-dev --no-install-project \
 && pip uninstall -y uv

COPY app ./app

USER ${UID}:${UID}
EXPOSE 8000
CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
